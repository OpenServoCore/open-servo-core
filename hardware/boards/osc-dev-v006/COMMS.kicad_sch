				(size 1.75 1.75)
				(thickness 0.1588)
			)
			(justify left top)
		)
		(uuid "74ff1f44-5899-49cb-9a12-5e7c5961d1b4")
	)
	(text_box "OSC BUS SUBSYSTEM"

		(at 18.034 32.512 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.25)
			)
			(justify left top)
		)
		(uuid "cc681932-950b-421c-a08f-c79b33b8dbc5")
	)
	(text_box "One wire, TTL level. USART1 half-duplex drives DATA directly, so no buffer and no TX_EN this time.\n\n- R23 is 33R instead of the usual 100R. DATA is the one line where edge speed matters (3Mbps over the whole chain), so it trades protection for speed and lets the TVS do the heavy lifting.\n- R1104 is DNP. The bus wants exactly ONE pull-up, at the host end, and servos self-bias internally. Populate it only when this board is the end of the wire on the bench.\n- D1102 clamps at the connector, BEFORE the series R. Order matters: connector -> TVS -> 33R -> pin.\n- Pinout is G,V,D with V in the center, so a reversed bench header only swaps DATA and GND, never power."
		(exclude_from_sim yes)
		(at 209.55 29.21 0)
		(size 72.39 64.77)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects

(footprint "Pot_Wire_Pads"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "SG90 pot leg pads, stock-board hole pattern. Origin = shaft axis; place encoder IC at the crosshair (opposite side). Outer holes 6.0mm c-c, wiper 3.33mm from each (1.45mm behind their line); all three on r~4.1mm about the axis, legs factory-formed +/-48deg from wiper. Body 9.92mm dia x 4.30mm, legs 4.78mm, shaft 1.35mm, rivet flare ~2.6mm (dashed circle); D3 magnet outline dash-dot. Stock board outline: 9.6 x 12.1mm incl 2mm trapezoid ear.")
